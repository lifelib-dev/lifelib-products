# Claude Code local settings, and the local doc-preview server config, which pins an
# absolute interpreter path
.claude/settings.local.json
.claude/launch.json

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# IDE settings
.idea/

# Python artifacts
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# modelx build output
# write_model(backup=True) drops <Model>_BAK<n>/ beside the model folder; regenerable.
*_BAK[0-9]*/
# mx.export_model output and anything modelx-cython compiles from it.
*_nomx/
*_nomx_cy/
*.pyd
*.so
*.mx
# The rest of what tools/build_sec_cy.py leaves when it builds in place, in the product
# directory (USLIB-SEC-PLAN.md D12): the setup.py mx2cy writes, and setuptools' build/
# tree, which holds the build's log too.  Anchored to the product directories, because a
# setup.py or a build/ anywhere else can be source: lifelib's own setup.py is, at its root.
lifelib/libraries/*/products/*/setup.py
lifelib/libraries/*/products/*/build/

# doc-check build tree (tools/doccheck.py)
.doccheck/
.doccheck.log

# Sphinx build output.  The page tree under doc/source/libraries/ is committed source,
# written by tools/gen_scaffolding.py, not build output.
doc/build/
